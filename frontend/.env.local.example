# Copy this file to ".env.local" ONLY if you want the frontend to talk to the
# standalone FastAPI backend instead of its built-in mock API routes.
#
#   cp .env.local.example .env.local        # macOS / Linux
#   Copy-Item .env.local.example .env.local # Windows PowerShell
#
# Then start the backend (see ../backend/README.md) and restart `npm run dev`.
# Leave this UNSET (no .env.local) to run the fully self-contained demo.

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
